const express = require('express');
const cors = require('cors');
const { authenticateJWT } = require('./src/middleware/auth');
require('dotenv').config();

// Importar rutas
const authRoutes = require('./src/routes/auth');
const clientRoutes = require('./src/routes/clients');
const workerRoutes = require('./src/routes/workers');
const statsRoutes = require('./src/routes/stats');
const backupRoutes = require('./src/routes/backup');

// Inicializar express
const app = express();
const PORT = process.env.PORT || 3000;

// Middleware global
app.use(cors());
app.use(express.json());

// Verificar la conexión inicial con la base de datos
const { checkDatabaseConnection } = require('./src/config/database');
checkDatabaseConnection()
    .then(() => console.log('Conexión inicial a la base de datos exitosa'))
    .catch(error => {
        console.error('Error al verificar la conexión inicial:', error);
        process.exit(1);
    });

// Configurar rutas
app.use('/auth', authRoutes);
app.use('/clients', authenticateJWT, clientRoutes);
app.use('/workers', authenticateJWT, workerRoutes);
app.use('/stats', authenticateJWT, statsRoutes);
app.use('/backup', authenticateJWT, backupRoutes);

// Iniciar el servidor
app.listen(PORT, () => {
    console.log(`Servidor corriendo en el puerto ${PORT}`);
});

// Manejo de errores global
app.use((err, req, res, next) => {
    console.error('Error no manejado:', err);
    res.status(500).json({
        error: 'Error interno del servidor',
        message: process.env.NODE_ENV === 'development' ? err.message : 'Ocurrió un error inesperado'
    });
});

// Manejo de rutas no encontradas
app.use((req, res) => {
    res.status(404).json({
        error: 'Ruta no encontrada',
        message: 'La ruta solicitada no existe'
    });
});